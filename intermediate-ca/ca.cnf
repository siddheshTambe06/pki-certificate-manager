[ca]
default_ca = CA_default

[CA_default]
dir = ./intermediate-ca
database = $dir/index.txt
new_certs_dir = $dir/newcerts
certificate = $dir/intermediate-ca.cert.pem
private_key = ./private/intermediate-ca.key.pem
serial = $dir/serial
crlnumber = $dir/crlnumber
default_md = sha256
default_days = 365
default_crl_days = 30
policy = policy_lab
copy_extensions = none
unique_subject = no
name_opt = ca_default
cert_opt = ca_default

[policy_lab]
countryName = match
stateOrProvinceName = optional
localityName = optional
organizationName = match
organizationalUnitName = optional
commonName = supplied
